{
  "$comment": "Ver docs-ai/DECISOES.md. Camada 1 do bloqueio é o hook PreToolUse (D-11), não estas regras. Deny aqui cobre apenas o que NENHUM agent pode tocar.",

  "permissions": {
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/credentials)",
      "Edit(.git/**)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(go get *)"
    ],

    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go tool *)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(gofmt *)",
      "Bash(govulncheck *)",
      "Bash(task *)",
      "Bash(wails3 build *)",
      "Bash(wails3 dev *)",
      "Bash(wails3 task *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add -A)",
      "Bash(git add -p)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool pipeline-hook"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && gofmt -w . 2>/dev/null; exit 0"
          }
        ]
      }
    ]
  }
}
