package main

import (
	"flag"
	"fmt"
	"io"
	"os"
)

var version = "dev"

func run(args []string, stdout, stderr io.Writer) int {
	fs := flag.NewFlagSet("{{NOME_DO_PROJETO}}", flag.ContinueOnError)
	fs.SetOutput(stderr)

	showVersion := fs.Bool("version", false, "Exibe a versão da aplicação")

	if err := fs.Parse(args); err != nil {
		return 1
	}

	if *showVersion {
		fmt.Fprintf(stdout, "{{NOME_DO_PROJETO}} %s\n", version)
		return 0
	}

	fmt.Fprintf(stdout, "{{NOME_DO_PROJETO}}: aplicação iniciada com sucesso.\n")
	return 0
}

func main() {
	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
}
