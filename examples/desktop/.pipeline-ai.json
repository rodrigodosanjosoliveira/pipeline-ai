{
  "version": 1,
  "project_type": "desktop",

  "protected_paths": [
    "internal/",
    "frontend/src/",
    "main.go",
    "Taskfile.yml"
  ],

  "editor_agents": [
    "dev-implementation",
    "test-writer",
    "code-reviewer",
    "query-performance",
    "docs-update"
  ],

  "security_surface_paths": [
    "internal/auth/",
    "internal/crypto/",
    "internal/storage/",
    "go.mod",
    "go.sum",
    "build/",
    ".github/workflows/"
  ],

  "deliveries_dir": "docs-ai/deliveries",
  "index_file": "docs-ai/deliveries/INDEX.md",
  "base_ref": "origin/main"
}
